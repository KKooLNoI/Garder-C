# UNVERIFIED example. Copy to judge0.conf and replace every placeholder; never commit the real file.
# Variable names follow the Judge0 1.13.x documentation; confirm them against the image you deploy.

# Auth: the web app and worker send this in the X-Auth-Token header (JUDGE0_AUTH_TOKEN in .env must match).
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=replace-with-a-long-random-token

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-REDIS_PASSWORD-from-.env

POSTGRES_HOST=judge0-db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Sandbox policy: submissions may not request network access.
ALLOW_ENABLE_NETWORK_PER_SUBMISSION=false
ENABLE_NETWORK=false

# Upper bounds enforced regardless of what a request asks for.
MAX_CPU_TIME_LIMIT=5
MAX_WALL_TIME_LIMIT=10
MAX_MEMORY_LIMIT=262144
MAX_MAX_FILE_SIZE=4096
MAX_MAX_PROCESSES_AND_OR_THREADS=60
