# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cpractice"
# Session lifetime in days
SESSION_TTL_DAYS=14
# Seed admin (used by `npm run db:seed` only; set a strong password)
SEED_ADMIN_USERNAME=admin
