SEED_ADMIN_PASSWORD=change-me-please
# Judge0 (Phase 4)
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_C_LANGUAGE_ID=50

# Docker Compose only
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
BACKUP_RETENTION_DAYS=14
